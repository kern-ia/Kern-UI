# Address the kern-ui server listens on.
KERN_UI_ADDR=127.0.0.1:7777

# Directory holding the built SPA. Set to internal/httpapi/dist after `make build-web`.
# Leave empty to serve the API only.
KERN_UI_WEB_DIR=internal/httpapi/dist

# Path to the local projection database. Created on first run.
# The authoritative run state lives in kern-orch checkpoints; this is a cache.
KERN_UI_DB=./kern-ui.db
